# Source revision metadata; installed LLVM discovery still uses MLIR/LLVMConfig.
include_guard(GLOBAL)

function(_triton_dependency_string filename field result)
  set(path "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/${filename}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
  file(READ "${path}" document)
  string(JSON schema_type TYPE "${document}" schema_version)
  string(JSON schema GET "${document}" schema_version)
  if(NOT schema_type STREQUAL "NUMBER" OR NOT schema STREQUAL "1")
    message(FATAL_ERROR "${path}: expected integer schema_version 1")
  endif()
  string(JSON field_type TYPE "${document}" "${field}")
  if(NOT field_type STREQUAL "STRING")
    message(FATAL_ERROR "${path}: ${field} must be a string")
  endif()
  string(JSON value GET "${document}" "${field}")
  set(${result} "${value}" PARENT_SCOPE)
endfunction()

_triton_dependency_string(llvm-info.json llvm_hash TRITON_LLVM_REVISION)
string(LENGTH "${TRITON_LLVM_REVISION}" revision_length)
if(NOT revision_length EQUAL 40 OR NOT TRITON_LLVM_REVISION MATCHES "^[0-9a-fA-F]+$")
  message(FATAL_ERROR "llvm-info.json: llvm_hash must be a full 40-character revision")
endif()

_triton_dependency_string(json-info.json version TRITON_JSON_VERSION)
if(NOT TRITON_JSON_VERSION MATCHES "^v[0-9]+\\.[0-9]+\\.[0-9]+$")
  message(FATAL_ERROR "json-info.json: version must be a release tag such as v3.11.3")
endif()
message(VERBOSE "Dependency metadata: LLVM ${TRITON_LLVM_REVISION}, JSON ${TRITON_JSON_VERSION}")
